# Copy to .env and adjust. Every variable is required: the app has no defaults (FE-STRUCT-007).

# --- Server-only (read at runtime, never sent to the browser) ---
# Backend base URL as the Next.js server sees it (in Docker: the API service name).
API_BASE_URL=http://localhost:8000
# Public URL of this frontend; used to check the Origin of state-changing requests (FE-AUTH-007).
APP_ORIGIN=http://localhost:3000
# true everywhere except plain-HTTP local development.
SESSION_COOKIE_SECURE=false
# Must match the backend's refresh token lifetime (7 days).
REFRESH_TOKEN_MAX_AGE_SECONDS=604800

# --- Public (inlined into the browser bundle at build time) ---
# local | development | staging | production
NEXT_PUBLIC_APP_ENV=local

# --- Tooling only ---
# pnpm api:pull
OPENAPI_URL=http://localhost:8000/openapi.json
# pnpm test:e2e — an existing backend user; signed-in tests are skipped when empty. Never commit real values.
E2E_EMAIL=
E2E_PASSWORD=
# Optional: an account with the User role (never an Admin), for My tasks; those tests are skipped
# when empty. The tests give it a throwaway task and delete the task again.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
